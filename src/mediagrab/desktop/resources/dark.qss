QWidget { background: #151b28; color: #e5eaf4; font-size: 13px; }
QMainWindow { background: #151b28; }
QLineEdit, QComboBox, QTableWidget { background: #1e283a; border: 1px solid #3b4962; border-radius: 5px; padding: 6px; }
QPushButton { background: #304363; border: 1px solid #4d6387; border-radius: 5px; padding: 7px 12px; }
QPushButton:hover { background: #405982; }
QPushButton:disabled { color: #8390a5; background: #232d3d; }
QPushButton#downloadButton { background: #365dc7; }
QGroupBox { border: 1px solid #3b4962; border-radius: 7px; margin-top: 12px; padding: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; }
QHeaderView::section { background: #26344b; padding: 8px; border: none; }
QProgressBar { border: 1px solid #52617a; background: #182132; text-align: center; border-radius: 4px; }
QProgressBar::chunk { background: #638cf5; }
QTableWidget::item:selected { background: #354c72; }
QMenu { background: #26344b; border: 1px solid #52617a; }
QMenu::item { padding: 7px 20px; }
QMenu::item:selected { background: #405982; }
